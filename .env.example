# Nothric Environment Variables Example
# Copy these key-value pairs into Netlify Site Settings -> Environment Variables

# Web3Forms API Key (Contact / Support forms)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# AI Provider API Keys
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GROQ_API_KEY=your_groq_api_key
VITE_GROQ_API_KEY_AUTO=your_groq_auto_picker_api_key
VITE_MISTRAL_API_KEY=your_mistral_api_key
VITE_COHERE_API_KEY=your_cohere_api_key
VITE_NVIDIA_API_KEY=your_nvidia_api_key
VITE_MEM0_API_KEY=your_mem0_api_key
VITE_TAVILY_API_KEY=your_tavily_api_key

# Cloudflare Configuration (D1 Database, KV Storage, Workers AI, Whisper Speech, TTS)
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
VITE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
VITE_CLOUDFLARE_KV_NAMESPACE_ID=your_cloudflare_kv_namespace_id

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend Email Configuration
VITE_RESEND_API_KEY=your_resend_api_key
